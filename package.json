    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
